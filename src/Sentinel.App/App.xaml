<Application x:Class="Sentinel.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <!-- Initial palette. Theme.Apply replaces every key with the same normal colors, or with system brushes in high contrast. -->
        <SolidColorBrush x:Key="Ink" Color="#1C1F1D"/>
        <SolidColorBrush x:Key="Muted" Color="#595E58"/>
        <SolidColorBrush x:Key="Accent" Color="#1F5C45"/>
        <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LinkInk" Color="#1F5C45"/>
        <SolidColorBrush x:Key="Positive" Color="#1E6B4D"/>
        <SolidColorBrush x:Key="Warning" Color="#8A5A12"/>
        <SolidColorBrush x:Key="DangerInk" Color="#A3271B"/>
        <SolidColorBrush x:Key="DangerSurface" Color="#FAECE9"/>
        <SolidColorBrush x:Key="DisabledInk" Color="#5F635E"/>
        <SolidColorBrush x:Key="CanvasSurface" Color="#F7F6F2"/>
        <SolidColorBrush x:Key="CardSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelSurface" Color="#F0EEE8"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#00000000"/>
        <SolidColorBrush x:Key="StatusSurface" Color="#F2F0EA"/>
        <SolidColorBrush x:Key="ControlSurface" Color="#EEECE6"/>
        <SolidColorBrush x:Key="HoverSurface" Color="#F0EEE8"/>
        <SolidColorBrush x:Key="HoverOverlay" Color="#0F000000"/>
        <SolidColorBrush x:Key="PressedOverlay" Color="#1F000000"/>
        <SolidColorBrush x:Key="InputSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBorder" Color="#8C887F"/>
        <SolidColorBrush x:Key="BorderSurface" Color="#D9D5CC"/>
        <SolidColorBrush x:Key="SeparatorSurface" Color="#E5E2DA"/>
        <SolidColorBrush x:Key="AlternateRowSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SelectionSurface" Color="#E2ECE5"/>
        <SolidColorBrush x:Key="SelectionInk" Color="#143A2C"/>
        <SolidColorBrush x:Key="FocusOutline" Color="#1F5C45"/>
        <SolidColorBrush x:Key="ChipNeutralSurface" Color="#ECEAE4"/>
        <SolidColorBrush x:Key="ChipPositiveSurface" Color="#E3EFE7"/>
        <SolidColorBrush x:Key="ChipWarningSurface" Color="#F6EAD3"/>
        <SolidColorBrush x:Key="ChipBorder" Color="#00000000"/>
        <!-- Navigation rail tokens are separate so light rail text never leaks into page controls. -->
        <SolidColorBrush x:Key="RailSurface" Color="#1E2320"/>
        <SolidColorBrush x:Key="SidebarSurface" Color="#1E2320"/>
        <SolidColorBrush x:Key="RailBorder" Color="#1E2320"/>
        <SolidColorBrush x:Key="RailInk" Color="#D5D9D4"/>
        <SolidColorBrush x:Key="RailMuted" Color="#9AA19B"/>
        <SolidColorBrush x:Key="RailHoverSurface" Color="#2A302C"/>
        <SolidColorBrush x:Key="RailSelectedSurface" Color="#343B36"/>
        <SolidColorBrush x:Key="RailSelectedInk" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="RailIndicator" Color="#7CC4A0"/>
        <SolidColorBrush x:Key="RailFocus" Color="#F2F0E8"/>
        <SolidColorBrush x:Key="RailBrand" Color="#7CC4A0"/>
        <sys:Double x:Key="HoverOpacity">0.92</sys:Double>
        <sys:Double x:Key="PressedOpacity">0.88</sys:Double>
        <sys:Double x:Key="DisabledOpacity">1</sys:Double>

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="{DynamicResource CardSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSurface}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                            <Border x:Name="Overlay" Background="Transparent" CornerRadius="6" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Border x:Name="FocusRing" Margin="-3" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Overlay" Property="Background" Value="{DynamicResource HoverOverlay}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Overlay" Property="Background" Value="{DynamicResource PressedOverlay}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Overlay" Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlSurface}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ControlSurface}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource FocusOutline}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource LinkInk}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource DangerInk}"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,0,0,2"/><Setter Property="Padding" Value="12,0,8,0"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource RailInk}"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <Border x:Name="Indicator" Width="3" HorizontalAlignment="Left" Margin="0,9" CornerRadius="1.5" Background="{DynamicResource RailIndicator}" Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <Border x:Name="FocusRing" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource RailHoverSurface}"/></Trigger>
                            <Trigger Property="Tag" Value="selected"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource RailSelectedSurface}"/><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource RailFocus}"/></Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="Tag" Value="selected"/><Condition Property="IsKeyboardFocused" Value="True"/></MultiTrigger.Conditions>
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource RailSelectedInk}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionSurface}"/><Setter Property="SelectionTextBrush" Value="{DynamicResource SelectionInk}"/>
            <Setter Property="Background" Value="{DynamicResource InputSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Grid>
                    <Border x:Name="Input" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                    </Border>
                    <Border x:Name="FocusRing" Margin="-2" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource FocusOutline}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/><Setter TargetName="Input" Property="Background" Value="{DynamicResource ControlSurface}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- Read-only evidence: selectable and focusable, without the chrome of an input field. -->
        <Style x:Key="Readout" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,2"/><Setter Property="MinHeight" Value="0"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionSurface}"/>
            <Setter Property="Background" Value="{DynamicResource InputSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
                <Grid>
                    <Border x:Name="Input" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                    </Border>
                    <Border x:Name="FocusRing" Margin="-2" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource FocusOutline}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/><Setter TargetName="Input" Property="Background" Value="{DynamicResource ControlSurface}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource InputSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="32"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="0,2,0,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" Margin="6,0,0,0"/></DataTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="DisclosureToggle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="38"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" Padding="6,4">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource FocusOutline}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <DockPanel>
                    <ToggleButton x:Name="HeaderToggle" DockPanel.Dock="Top" Style="{StaticResource DisclosureToggle}" Margin="-8,0,0,0"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"/>
                    <ContentPresenter x:Name="Body" Margin="22,0,0,0" Visibility="Collapsed"/>
                </DockPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- Status chips. Tag selects the tone: Neutral, Positive, Warning or Danger. Text is always present; color is never the only signal. -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="7,2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ChipNeutralSurface}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Positive"><Setter Property="Background" Value="{DynamicResource ChipPositiveSurface}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Positive}"/></Trigger>
                <Trigger Property="Tag" Value="Warning"><Setter Property="Background" Value="{DynamicResource ChipWarningSurface}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Warning}"/></Trigger>
                <Trigger Property="Tag" Value="Danger"><Setter Property="Background" Value="{DynamicResource DangerSurface}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource DangerInk}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TableText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="12,0"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource CardSurface}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,0"/><Setter Property="BorderBrush" Value="{DynamicResource SeparatorSurface}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource SeparatorSurface}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionSurface}"/><Setter Property="Foreground" Value="{DynamicResource SelectionInk}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionSurface}"/><Setter Property="Foreground" Value="{DynamicResource SelectionInk}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusOutline}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource CardSurface}"/><Setter Property="RowBackground" Value="{DynamicResource CardSurface}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource AlternateRowSurface}"/>
            <Setter Property="RowHeight" Value="38"/><Setter Property="ColumnHeaderHeight" Value="34"/><Setter Property="FontSize" Value="13"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="Margin" Value="0"/>
        </Style>
    </Application.Resources>
</Application>
